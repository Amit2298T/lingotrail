{
  "name": "lingotrail",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup:env": "node scripts/setup-env.mjs",
    "format": "prettier --write src/app src/components src/lib prisma/seed.ts tests scripts *.md",
    "test:neon": "node --import tsx scripts/test-neon.ts"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "^8.16.3",
    "better-auth": "1.7.6",
    "motion": "13.4.5",
    "lucide-react": "^0.468.0",
    "zod": "^4.1.0",
    "dotenv": "^17.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/pg": "^8.15.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "prettier": "^3.6.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
