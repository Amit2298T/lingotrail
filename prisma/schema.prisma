generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  attempts      Attempt[]
  completions   Completion[]
  activities    Activity[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

model Profile {
  selectedCourseId String   @default("english-hi")
  selectedCourse   Course   @relation(fields: [selectedCourseId], references: [id], onDelete: Restrict)
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal             Int      @default(10)
  timezone         String   @default("Asia/Kolkata")
  createdAt        DateTime @default(now())
}

model Course {
  profiles       Profile[]
  id             String    @id
  title          String
  sourceLanguage String
  targetLanguage String
  lessons        Lesson[]
}

model Lesson {
  id          String       @id
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  subtitle    String
  unit        String
  position    Int
  color       String
  icon        String
  exercises   Exercise[]
  attempts    Attempt[]
  completions Completion[]

  @@unique([courseId, position])
}

model Exercise {
  acceptedAnswers Json      @default("[]")
  tokenJoiner     String    @default(" ")
  reading         String?
  id              String    @id
  lessonId        String
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  position        Int
  kind            String
  prompt          String
  hint            String
  options         Json
  answer          String
  explanation     String
  spokenText      String?
  attempts        Attempt[]

  @@unique([lessonId, position])
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  answer     String
  correct    Boolean
  solved     Boolean  @default(false)
  attempts   Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@unique([userId, exerciseId])
  @@index([userId, lessonId])
}

model Completion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  xp        Int      @default(20)
  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model Activity {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day          String
  correctCount Int    @default(0)

  @@unique([userId, day])
}
